<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Blog Admin Yönetimi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button"><i class="fas fa-bars"></i></a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-danger" asp-area="Admin" asp-controller="Auth" asp-action="Logout">
                            <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-body-secondary shadow-sm" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a href="#" class="brand-link">
                    <span class="brand-text fw-light">Blog Yönetim Paneli</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Anasayfa</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-list"></i>
                                <p>Kategoriler</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Post" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-edit"></i>
                                <p>Yazı Yönetimi</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Tag/Index" class="nav-link">
                                <i class="nav-icon fas fa-tags"></i>
                                <p>Etiket Yönetimi</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/Admin/Comment/Index" class="nav-link">
                                <i class="nav-icon fas fa-comments"></i>
                                <p>Yorumlar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Kullanıcı Yönetimi</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="SiteSetting" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-cog"></i>
                                <p>Genel Ayarlar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Page" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Sayfalar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="ContactMessage" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-envelope"></i>
                                <p>
                                    Gelen Mesajlar
                                    @await Component.InvokeAsync("UnreadMessageCount")
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Auth" asp-action="Logout" class="nav-link">
                                <i class="nav-icon fas fa-sign-out-alt"></i>
                                <p>Çıkış Yap</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <main class="app-main">
            @RenderBody()
        </main>

        <footer class="app-footer border-top bg-white mt-4">
            <div class="float-end d-none d-sm-inline text-muted">
                <i class="fas fa-code-branch me-1 text-info"></i>
                <span class="fw-bold text-dark">Jetexsoft Blog Sistemi</span>
                <span class="badge bg-light text-dark border ms-1">v1.0.0</span>
            </div>

            <strong>
                Copyright &copy; @DateTime.Now.Year
                <a href="https://jetexsoft.com.tr" target="_blank" class="text-decoration-none fw-bold text-primary">
                    Jetexsoft
                </a>.
            </strong>
            <span class="text-muted">Tüm hakları saklıdır.</span>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta2/dist/js/adminlte.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <script>
        $(document).ready(function() {
            // "summernote-editor" class'ına sahip tüm textareaları editöre çevir
            $('.summernote-editor').summernote({
                height: 400, // Editörün varsayılan yüksekliği
                tabsize: 2,
                placeholder: 'İçeriğinizi buraya yazın...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']], // Tablo ekleme aracı!
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']] // İŞTE SİHİRLİ BUTON: codeview
                ]
            });
        });
    </script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sınıfı 'btn-delete' olan tüm butonları yakala
            const deleteButtons = document.querySelectorAll('.btn-delete');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault(); // Butona basıldığında anında sayfaya gitmeyi durdur

                    const url = this.getAttribute('href');
                    const itemName = this.getAttribute('data-name') || 'Bu kayıt'; // data-name yoksa varsayılan metin

                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: `${itemName} silinecek. Bu işlemi onaylıyor musunuz?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Evet, Sil!',
                        cancelButtonText: 'İptal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Kullanıcı onay verirse, yakaladığımız URL'ye yönlendir
                            window.location.href = url;
                        }
                    });
                });
            });
        });
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                Swal.fire({
                    position: 'top-end',
                    icon: 'success',
                    title: 'Başarılı!',
                    text: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
                    showConfirmButton: false,
                    timer: 2500,
                    toast: true
                });
            });
        </script>
    }

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.jetex-table').DataTable({
                // 1. TAMAMEN TEMİZ VE KONTROLLÜ TÜRKÇE DİL DESTEĞİ
                "language": {
                    "emptyTable": "Tabloda herhangi bir kayıt bulunamadı.",
                    "info": "Toplam _TOTAL_ kayıttan _START_ ile _END_ arası gösteriliyor",
                    "infoEmpty": "Kayıt yok",
                    "infoFiltered": "(_MAX_ kayıt içerisinden filtrelendi)",
                    "lengthMenu": "_MENU_ kayıt göster",
                    "loadingRecords": "Yükleniyor...",
                    "processing": "İşleniyor...",
                    "search": "Ara:",
                    "zeroRecords": "Eşleşen kayıt bulunamadı",
                    "paginate": {
                        "first": "İlk",
                        "last": "Son",
                        "next": "Sonraki",
                        "previous": "Önceki"
                    }
                },
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,

                // 2. MÜKEMMEL UI YERLEŞİMİ İÇİN DOM AYARI (Arama ve Sayfalama kısımlarına p-3 ile boşluk verdik)
                "dom": "<'row p-3 pb-0'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row p-3 pt-2'<'col-sm-12 col-md-5 text-muted'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
    <script>
        // Sistemdeki tüm 'btn-delete' sınıfına sahip butonları dinle
        $(document).on('click', '.btn-delete', function (e) {
            e.preventDefault(); // Linkin sayfayı yenilemesini (yönlendirmeyi) durdur

            var url = $(this).attr('href'); // Gidilecek silme adresini al
            var tr = $(this).closest('tr'); // Tıklanan butonun bulunduğu <tr> satırını yakala

            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu kayıt kalıcı olarak silinecektir ve bu işlem geri alınamaz!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash-alt me-1"></i> Evet, Sil!',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {

                    // AJAX ile arka planda sessizce silme isteğini gönder
                    $.ajax({
                        url: url,
                        type: 'GET',
                        success: function () {
                            // İşlem başarılıysa DataTables objesini bul
                            var table = $('.jetex-table').DataTable();

                            // İlgili satırı tablodan sil ve tabloyu yeniden çiz
                            // (İçindeki 'false' parametresi, kullanıcının bulunduğu sayfayı değiştirmemesini sağlar)
                            table.row(tr).remove().draw(false);

                            // Ekranın ortasında değil, sağ üstte zarif bir "Toast" bildirimi çıkar
                            Swal.fire({
                                title: 'Başarılı!',
                                text: 'Kayıt kalıcı olarak silindi.',
                                icon: 'success',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });
                        },
                        error: function () {
                            // Eğer C# tarafında (veritabanında) bir hata olursa uyarı ver
                            Swal.fire('Hata!', 'İşlem sırasında sunucuda bir sorun oluştu.', 'error');
                        }
                    });
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>