@using Blog.Core.Enums
@model Blog.Web.Areas.Admin.Models.PostCreateViewModel
@{
    ViewData["Title"] = "Yeni Yazı";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Yeni Yazı Ekle</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="postForm">
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Başlık</label>
                        <input asp-for="Title" class="form-control" required>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label">Kategori</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required>
                            <option value="">Seçiniz...</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-tags text-warning"></i> Etiketler</label>
                        <select asp-for="SelectedTags" asp-items="ViewBag.Tags" class="form-control select2" multiple="multiple"></select>
                        <small class="text-muted">Aramak için yazın, birden fazla etiket seçebilirsiniz.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CoverImageFile" class="form-label">Kapak Fotoğrafı</label>
                        <input asp-for="CoverImageFile" type="file" class="form-control" accept="image/jpeg, image/png, image/webp">
                        <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">İçerik</label>
                        <textarea asp-for="Content" class="form-control summernote-post-editor"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Yayın Durumu</label>
                        <select asp-for="Status" class="form-select">
                            <option value="@PostStatus.Draft">Taslak (Yayına Almaz)</option>
                            <option value="@PostStatus.Published">Yayında (Sitede Görünür)</option>
                        </select>
                        <small class="text-muted">Yazınızı hazırlamaya devam edecekseniz 'Taslak' olarak bırakın.</small>
                    </div>

                    <hr class="my-4">
                    <h5 class="text-primary mb-3"><i class="fas fa-search"></i> SEO Ayarları</h5>

                    <div class="mb-3">
                        <label asp-for="MetaTitle" class="form-label">SEO Başlığı (Meta Title)</label>
                        <input asp-for="MetaTitle" class="form-control" placeholder="Örn: Yazılım Dersleri | Harika Blog" maxlength="70">
                        <small class="text-muted"><i class="fas fa-info-circle"></i> Boş bırakırsanız Google'da standart kategori adı görünür. Maks. 70 karakter.</small>
                        <span asp-validation-for="MetaTitle" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MetaDescription" class="form-label">SEO Açıklaması (Meta Description)</label>
                        <textarea asp-for="MetaDescription" class="form-control" rows="2" placeholder="Kategorinin arama motorlarında çıkacak kısa açıklamasını buraya yazın..." maxlength="160"></textarea>
                        <small class="text-muted"><i class="fas fa-info-circle"></i> Maksimum 160 karakter önerilir.</small>
                        <span asp-validation-for="MetaDescription" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-success">Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {

            // 1. Etiketler için Select2 Başlatma
            $('.select2').select2({
                tags: true,
                tokenSeparators: [',', ' '],
                placeholder: "Listeden seçin veya yeni yazıp Enter'a basın...",
                allowClear: true,
                width: '100%'
            });

            // 2. Makale İçeriği için Özel AJAX Resim Yüklemeli Summernote
            $('.summernote-post-editor').summernote({
                height: 400,
                placeholder: 'Yazı içeriğini buraya girin...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ],
                callbacks: {
                    // Resim ekle butonuna basıldığında (veya sürükle bırak yapıldığında) tetiklenir
                    onImageUpload: function(files) {
                        for (let i = 0; i < files.length; i++) {
                            uploadImageToController(files[i], this);
                        }
                    }
                }
            });

            // 3. Özel Resim Yükleme (Senin eski AJAX kodunun Summernote'a uyarlanmış hali)
            function uploadImageToController(file, editor) {
                var formData = new FormData();
                formData.append("file", file);

                $.ajax({
                    url: '/Admin/Post/UploadEditorImage', // Senin yazdığın C# uç noktası
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            // C#'tan dönen URL'i Summernote'un içine göm
                            $(editor).summernote('insertImage', response.url);
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Resim yüklenirken sunucu hatası oluştu.');
                    }
                });
            }

        });
    </script>
}