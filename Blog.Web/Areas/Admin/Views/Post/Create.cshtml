@using Blog.Core.Enums
@model Blog.Web.Areas.Admin.Models.PostCreateViewModel
@{
    ViewData["Title"] = "Yeni Yazı";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Yeni Yazı Ekle</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="postForm">
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Başlık</label>
                        <input asp-for="Title" class="form-control" required>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label">Kategori</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required>
                            <option value="">Seçiniz...</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-tags text-warning"></i> Etiketler</label>
                        <select asp-for="SelectedTags" asp-items="ViewBag.Tags" class="form-control select2" multiple="multiple"></select>
                        <small class="text-muted">Aramak için yazın, birden fazla etiket seçebilirsiniz.</small>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CoverImageFile" class="form-label">Kapak Fotoğrafı</label>
                        <input asp-for="CoverImageFile" type="file" class="form-control" accept="image/jpeg, image/png, image/webp">
                        <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">İçerik</label>

                        <input type="hidden" asp-for="Content" id="hiddenContent">

                        <div id="quillEditor" style="height: 350px; background-color: #fff;"></div>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Yayın Durumu</label>
                        <select asp-for="Status" class="form-select">
                            <option value="@PostStatus.Draft">Taslak (Yayına Almaz)</option>
                            <option value="@PostStatus.Published">Yayında (Sitede Görünür)</option>
                        </select>
                        <small class="text-muted">Yazınızı hazırlamaya devam edecekseniz 'Taslak' olarak bırakın.</small>
                    </div>

                    <hr class="my-4">
                    <h5 class="text-primary mb-3"><i class="fas fa-search"></i> SEO Ayarları</h5>

                    <div class="mb-3">
                        <label asp-for="MetaTitle" class="form-label">SEO Başlığı (Meta Title)</label>
                        <input asp-for="MetaTitle" class="form-control" placeholder="Örn: Yazılım Dersleri | Harika Blog" maxlength="70">
                        <small class="text-muted"><i class="fas fa-info-circle"></i> Boş bırakırsanız Google'da standart kategori adı görünür. Maks. 70 karakter.</small>
                        <span asp-validation-for="MetaTitle" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MetaDescription" class="form-label">SEO Açıklaması (Meta Description)</label>
                        <textarea asp-for="MetaDescription" class="form-control" rows="2" placeholder="Kategorinin arama motorlarında çıkacak kısa açıklamasını buraya yazın..." maxlength="160"></textarea>
                        <small class="text-muted"><i class="fas fa-info-circle"></i> Maksimum 160 karakter önerilir.</small>
                        <span asp-validation-for="MetaDescription" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-success">Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // 1. Özel Resim Yükleme Fonksiyonu
        function selectLocalImage() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();

            input.onchange = () => {
                const file = input.files[0];
                if (file) {
                    const formData = new FormData();
                    formData.append('file', file);

                    $.ajax({
                        url: '/Admin/Post/UploadEditorImage',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function(response) {
                            if (response.success) {
                                // Başarılıysa resmi imlecin olduğu yere ekle
                                const range = quill.getSelection(true);
                                quill.insertEmbed(range.index, 'image', response.url);
                                quill.setSelection(range.index + 1);
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function() {
                            alert('Resim yüklenirken sunucu hatası oluştu.');
                        }
                    });
                }
            };
        }

        // 2. Quill Editörünü Başlatıyoruz
        var quill = new Quill('#quillEditor', {
            theme: 'snow',
            placeholder: 'Yazı içeriğini buraya girin...',
            modules: {
                toolbar: {
                    container: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        ['blockquote', 'code-block'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'color': [] }, { 'background': [] }],
                        ['link', 'image', 'clean'] // 'image' buraya eklendi
                    ],
                    handlers: {
                        // Resim butonuna basılınca standart Base64 yerine bizim fonksiyonu çalıştır!
                        image: selectLocalImage
                    }
                }
            }
        });

        // 3. Form gönderilirken HTML'i aktar
        var form = document.getElementById('postForm');
        form.onsubmit = function() {
            var hiddenContent = document.getElementById('hiddenContent');
            hiddenContent.value = quill.root.innerHTML;
        };

        // 4. Select2 Başlatma
        $(document).ready(function() {
            $('.select2').select2({
                tags: true,
                tokenSeparators: [',', ' '],
                placeholder: "Listeden seçin veya yeni yazıp Enter'a basın...",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}