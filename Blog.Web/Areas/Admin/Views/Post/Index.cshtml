@model IEnumerable<Blog.Core.Entities.Post>
@{
    ViewData["Title"] = "Yazılar";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Yazı Yönetimi</h3></div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Yeni Yazı Ekle</a>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <table class="table table-bordered table-hover jetex-table">
                    <thead>
                        <tr>
                            <th>Görsel</th>
                            <th>Başlık</th>
                            <th>Kategori</th>
                            <th>Yazar</th>
                            <th>Tarih</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.CoverImagePath))
                                    {
                                        <img src="@item.CoverImagePath" alt="Kapak" style="width:50px; height:50px; object-fit:cover; border-radius:4px;" />
                                    }
                                </td>
                                <td>@item.Title</td>
                                <td><span class="badge bg-secondary">@item.Category?.Name</span></td>

                                <td>
                                    @if (item.AppUser != null)
                                    {
                                        <span class="text-primary fw-bold">@item.AppUser.FirstName @item.AppUser.LastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Bilinmiyor</span>
                                    }
                                </td>

                                <td>@item.CreatedDate.ToShortDateString()</td>
                                <td class="text-end px-3">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm border shadow-sm px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="İşlemler">
                                            <i class="fas fa-ellipsis-v text-muted"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li>
                                                <a class="dropdown-item py-2" href="/@item.Slug" target="_blank">
                                                    <i class="fas fa-external-link-alt text-info me-2"></i> Sitede Gör
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@item.Id">
                                                    <i class="fas fa-edit text-primary me-2"></i> Düzenle
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item py-2 text-danger btn-delete" asp-action="Delete" asp-route-id="@item.Id">
                                                    <i class="fas fa-trash-alt me-2"></i> Sil
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>