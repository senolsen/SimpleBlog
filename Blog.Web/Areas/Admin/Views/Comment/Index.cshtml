@model IEnumerable<Blog.Core.Entities.Comment>
@{
    ViewData["Title"] = "Yorumlar";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Yorum Yönetimi</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card card-outline card-primary">
            <div class="card-body p-0">
                <table class="table table-striped table-hover jetex-table">
                    <thead>
                        <tr>
                            <th>Yazar</th>
                            <th>Yorum İçeriği</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Name</strong><br />
                                    <small class="text-muted">@item.Email</small>
                                </td>
                                <td style="max-width: 300px; white-space: normal;">
                                    @item.Content
                                </td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (item.IsApproved)
                                    {
                                        <span class="badge bg-success">Yayında</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                                    }
                                </td>
                                <td class="text-end px-3">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm border shadow-sm px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="İşlemler">
                                            <i class="fas fa-ellipsis-v text-muted"></i>
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                                            @if (!item.IsApproved)
                                            {
                                                <li>
                                                    <form asp-action="Approve" asp-route-id="@item.Id" method="post">
                                                        <button type="submit" class="dropdown-item py-2">
                                                            <i class="fas fa-check-circle text-success me-2"></i> Yorumu Onayla
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <form asp-action="Reject" asp-route-id="@item.Id" method="post">
                                                        <button type="submit" class="dropdown-item py-2">
                                                            <i class="fas fa-times-circle text-warning me-2"></i> Yayından Kaldır
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            <li><hr class="dropdown-divider"></li>

                                            <li>
                                                <a class="dropdown-item py-2 text-danger btn-delete" asp-action="Delete" asp-route-id="@item.Id">
                                                    <i class="fas fa-trash-alt me-2"></i> Kalıcı Olarak Sil
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>