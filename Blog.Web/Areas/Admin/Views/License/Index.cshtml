@model Blog.Core.Entities.License
@{
    ViewData["Title"] = "Lisans Yönetimi";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0"><i class="fas fa-key me-2"></i> Ürün Etkinleştirme</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card card-outline card-primary shadow">
                    <div class="card-header text-center">
                        <img src="/admin/dist/assets/img/jetexsoft-logo.png" alt="Jetexsoft" style="height:50px;" class="mb-2">
                        <p class="mb-0 text-muted">Blog projenizi kullanmaya başlamak için lisans anahtarınızı girin.</p>
                    </div>
                    <form asp-action="Update" method="post">
                        <div class="card-body">
                            <div class="form-group mb-3">
                                <label class="form-label">Lisans Anahtarı</label>
                                <textarea name="licenseKey" class="form-control" rows="4" placeholder="Jetexsoft tarafından size iletilen kodu buraya yapıştırın...">@Model.Key</textarea>
                            </div>

                            <div class="alert alert-info py-2 mb-3">
                                <small><i class="fas fa-info-circle me-1"></i> Bu lisans sadece <strong>@Context.Request.Host.Host</strong> alan adı için geçerlidir.</small>
                            </div>

                            <div class="alert alert-light border py-2 mb-0">
                                <small class="text-muted">
                                    Sorun yaşıyorsanız:
                                    <a href="mailto:destek@jetexsoft.com.tr">destek@jetexsoft.com.tr</a>
                                </small>
                            </div>
                        </div>
                        <div class="card-footer d-grid">
                            <button type="submit" class="btn btn-primary btn-block">Lisansı Doğrula ve Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>