@model IEnumerable<Category>
@{
    ViewData["Title"] = "Kategoriler";
}
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Kategori Yönetimi</h3></div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary">Yeni Kategori Ekle</a>
            </div>
        </div>
    </div>
</div>
<div class="app-content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <table class="table table-bordered table-hover jetex-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kategori Adı</th>
                            <th>Oluşturulma Tarihi</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>@item.CreatedDate.ToShortDateString()</td>
                                <td class="text-end px-3">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm border shadow-sm px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="İşlemler">
                                            <i class="fas fa-ellipsis-v text-muted"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@item.Id">
                                                    <i class="fas fa-edit text-primary me-2"></i> Düzenle
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item py-2 text-danger btn-delete" asp-action="Delete" asp-route-id="@item.Id">
                                                    <i class="fas fa-trash-alt me-2"></i> Sil
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>