@model IEnumerable<Blog.Core.Entities.ContactMessage>
@{
    ViewData["Title"] = "Gelen Mesajlar";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0"><i class="fas fa-envelope me-2"></i> Gelen Mesajlar</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-body table-responsive p-0">
                <table class="table table-hover text-nowrap jetex-table">
                    <thead>
                        <tr>
                            <th>Gönderen</th>
                            <th>E-Posta</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Okunmamış mesajlar için satırı vurgula
                            var fwClass = item.IsRead ? "fw-normal" : "fw-bold text-primary";

                            <tr>
                                <td class="@fwClass">@item.Name</td>
                                <td class="@fwClass">@item.Email</td>
                                <td class="@fwClass">@item.Subject</td>
                                <td class="@fwClass">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end px-3">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm border shadow-sm px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="İşlemler">
                                            <i class="fas fa-ellipsis-v text-muted"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Details" asp-route-id="@item.Id">
                                                    <i class="fas fa-envelope-open-text text-primary me-2"></i> Mesajı Oku
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item py-2 text-danger btn-delete" asp-action="Delete" asp-route-id="@item.Id">
                                                    <i class="fas fa-trash-alt me-2"></i> Sil
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                      
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>