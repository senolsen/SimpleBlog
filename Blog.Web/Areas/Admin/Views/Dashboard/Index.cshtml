@model Blog.Web.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0"><i class="fas fa-chart-line me-2"></i> Yönetim Özeti</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info rounded shadow-sm">
                    <div class="inner p-3">
                        <h3>@Model.TotalViews</h3>
                        <p>@(User.IsInRole("Admin") || User.IsInRole("Editör") ? "Toplam Görüntülenme" : "Yazılarımın Okunması")</p>
                    </div>
                    <div class="icon" style="opacity: 0.3; right: 20px; top: 15px;">
                        <i class="fas fa-eye fa-3x"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success rounded shadow-sm">
                    <div class="inner p-3">
                        <h3>@Model.TotalPosts</h3>
                        <p>Yayınlanan Makale</p>
                    </div>
                    <div class="icon" style="opacity: 0.3; right: 20px; top: 15px;">
                        <i class="fas fa-edit fa-3x"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning rounded shadow-sm">
                    <div class="inner p-3">
                        <h3>@Model.TotalComments</h3>
                        <p>Okur Yorumu</p>
                    </div>
                    <div class="icon" style="opacity: 0.3; right: 20px; top: 15px;">
                        <i class="fas fa-comments fa-3x text-dark"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger rounded shadow-sm">
                    <div class="inner p-3">
                        <h3>@Model.TotalCategories</h3>
                        <p>Aktif Kategori</p>
                    </div>
                    <div class="icon" style="opacity: 0.3; right: 20px; top: 15px;">
                        <i class="fas fa-list fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="card card-primary card-outline shadow-sm">
                    <div class="card-header border-0">
                        <h3 class="card-title fw-bold"><i class="fas fa-fire text-danger me-1"></i> En Çok Okunan 10 Makale</h3>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-striped table-valign-middle">
                            <thead>
                                <tr>
                                    <th>Makale Başlığı</th>
                                    <th class="text-center">Kategori ID</th>
                                    <th class="text-center">Okunma (Görüntülenme)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var post in Model.TopPosts)
                                {
                                    <tr>
                                        <td>
                                            <a href="/Post/@post.Slug" target="_blank" class="text-dark fw-semibold text-decoration-none">
                                                @post.Title
                                            </a>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">Kategori: @post.CategoryId</span>
                                        </td>
                                        <td class="text-center fw-bold text-success">
                                            <i class="fas fa-arrow-up me-1"></i> @post.ViewCount
                                        </td>
                                    </tr>
                                }
                                @if (!Model.TopPosts.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">Henüz okunma istatistiği oluşmamış.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card card-info card-outline shadow-sm">
                    <div class="card-header border-0">
                        <h3 class="card-title fw-bold"><i class="fas fa-chart-pie text-info me-1"></i> Kategori Dağılımı</h3>
                    </div>
                    <div class="card-body">
                        <canvas id="categoryChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {
            // Controller'dan gelen verileri JavaScript dizilerine çeviriyoruz
            const labels = @Html.Raw(Json.Serialize(Model.ChartCategoryNames));
            const dataCounts = @Html.Raw(Json.Serialize(Model.ChartPostCounts));

            // Grafik Çizimi (Pie Chart)
            const ctx = document.getElementById('categoryChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut', // 'pie' da yapılabilir
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Makale Sayısı',
                        data: dataCounts,
                        backgroundColor: [
                            '#f56954', '#00a65a', '#f39c12', '#00c0ef', '#3c8dbc', '#d2d6de', '#8e44ad', '#2c3e50'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        });
    </script>
}