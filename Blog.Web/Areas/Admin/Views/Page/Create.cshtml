@model Blog.Core.Entities.Page
@{
    ViewData["Title"] = "Yeni Sayfa";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Yeni Statik Sayfa Ekle</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card card-primary card-outline shadow-sm">
            <form asp-action="Create" method="post" id="pageForm">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Sayfa Başlığı</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Gizlilik Politikası" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sayfa İçeriği</label>
                        <input type="hidden" asp-for="Content" id="hiddenContent">

                        <div id="quillEditor" style="height: 350px; background-color: #fff;"></div>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked>
                        <label asp-for="IsActive" class="form-check-label">Sayfa Aktif mi?</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Sayfayı Yayınla</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

    <script>
        // Quill Editörünü Başlatıyoruz
        var quill = new Quill('#quillEditor', {
            theme: 'snow',
            placeholder: 'Sayfa içeriğini buraya girin...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    [{ 'color': [] }, { 'background': [] }],
                    ['link', 'clean']
                ]
            }
        });

        // Form gönderilirken (Submit) çalışacak olay
        var form = document.getElementById('pageForm');
        form.onsubmit = function() {
            var hiddenContent = document.getElementById('hiddenContent');
            // Editörün içindeki HTML formatlı metni gizli input'a aktar
            hiddenContent.value = quill.root.innerHTML;
        };
    </script>
}