@model Blog.Core.Entities.Page
@{
    ViewData["Title"] = "Yeni Sayfa";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Yeni Statik Sayfa Ekle</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card card-primary card-outline shadow-sm">
            <form asp-action="Create" method="post" id="pageForm">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Sayfa Başlığı</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Gizlilik Politikası" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sayfa İçeriği</label>
                        <textarea asp-for="Content" class="form-control summernote-editor"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked>
                        <label asp-for="IsActive" class="form-check-label">Sayfa Aktif mi?</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Sayfayı Yayınla</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>