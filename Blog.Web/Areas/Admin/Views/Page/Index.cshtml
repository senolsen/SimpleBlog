@model IEnumerable<Blog.Core.Entities.Page>
@{
    ViewData["Title"] = "Sayfa Yönetimi";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Statik Sayfalar</h3></div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Yeni Sayfa Ekle</a>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sayfa Başlığı</th>
                            <th>URL (Slug)</th>
                            <th class="text-center">Durum</th>
                            <th class="text-end px-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Title</td>
                                <td><small class="text-muted">/@item.Slug</small></td>
                                <td class="text-center">
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">@(item.IsActive ? "Aktif" : "Pasif")</span>
                                </td>
                                <td class="text-end px-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1 btn-delete" data-name="@item.Title"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>