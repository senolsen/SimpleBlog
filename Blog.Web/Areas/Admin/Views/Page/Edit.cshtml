@model Blog.Core.Entities.Page
@{
    ViewData["Title"] = "Sayfayı Düzenle";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Sayfa Düzenle: @Model.Title</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card card-info card-outline shadow-sm">
            <form asp-action="Edit" method="post" id="pageForm">
                <input type="hidden" asp-for="Id" />
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Sayfa Başlığı</label>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sayfa İçeriği</label>
                        <textarea asp-for="Content" class="form-control summernote-editor"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox">
                        <label asp-for="IsActive" class="form-check-label">Sayfa Aktif mi?</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-info text-white"><i class="fas fa-sync me-1"></i> Değişiklikleri Güncelle</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@* Not: @section Scripts alanı tamamen silindi çünkü eski Quill.js kütüphanelerine ihtiyacımız kalmadı. 
    Summernote kütüphaneleri Layout üzerinden otomatik yüklenip "summernote-editor" class'ını bulacaktır.
*@