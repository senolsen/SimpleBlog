{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "yourdomain.com;www.yourdomain.com",
  "DatabaseSettings": {
    "ActiveProvider": "SqlServer"
  },
  "ConnectionStrings": {
    "SqlServerConnection": "Server=YOUR_SERVER;Database=Ablogcms;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;",
    "MySqlConnection": "Server=YOUR_SERVER;Database=Ablogcms;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;",
    "SqliteConnection": "Data Source=App_Data/Ablogcms.db;Password=CHANGE_THIS_PASSWORD;"
  },
  "LicenseSettings": {
    "SupportEmail": "destek@jetexsoft.com.tr",
    "SupportUrl": "https://jetexsoft.com.tr",
    "CompanyName": "Jetexsoft"
  },
  "UpdateSettings": {
    "Enabled": true,
    "GitHubOwner": "senolsen",
    "GitHubRepo": "SimpleBlog",
    "GitHubToken": "",
    "AssetFileNamePattern": ".zip",
    "RestartStrategy": "Auto",
    "LinuxRestartTouchFile": "tmp/restart.txt"
  }
}
