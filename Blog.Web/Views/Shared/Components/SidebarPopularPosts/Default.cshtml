@model IEnumerable<Blog.Core.Entities.Post>

<div class="sidebar-item trending mt-5">
    <h3 class="sidebar-title">En Çok Okunanlar</h3>
    <ul class="mt-3 list-unstyled">
        @if (Model != null && Model.Any())
        {
            int rank = 1;
            foreach (var post in Model)
            {
                <li class="d-flex align-items-center mb-3 border-bottom pb-2">
                    <span class="fs-3 fw-bold text-black-50 me-3">@rank.ToString("D2")</span>
                    <div>
                        <h4 class="fs-6 mb-1 fw-bold">
                            <a href="/Makale/@post.Slug" class="text-decoration-none text-dark hover-primary">
                                @post.Title
                            </a>
                        </h4>
                        <span class="text-muted" style="font-size: 13px;">
                            <i class="bi bi-folder me-1 text-warning"></i> @post.Category.Name
                            <span class="mx-1">&bullet;</span>
                            <i class="bi bi-eye me-1 text-info"></i> @post.ViewCount
                        </span>
                    </div>
                </li>
                rank++;
            }
        }
        else
        {
            <li><span class="text-muted">Henüz makale bulunmuyor.</span></li>
        }
    </ul>
</div>