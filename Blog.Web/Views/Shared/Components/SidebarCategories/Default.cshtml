@model Dictionary<Blog.Core.Entities.Category, int>

<style>
    /* Kaydırma Çubuğu (Scroll) Stilleri */
    .category-scroll {
        max-height: 350px;
        overflow-y: auto;
        padding-right: 15px;
    }

        .category-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .category-scroll::-webkit-scrollbar-track {
            background: #f8f9fa;
            border-radius: 10px;
        }

        .category-scroll::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 10px;
        }

            .category-scroll::-webkit-scrollbar-thumb:hover {
                background: #adb5bd;
            }
</style>

<div class="sidebar-item categories mt-5">
    <h3 class="sidebar-title">Kategoriler</h3>

    <div class="mb-4 position-relative category-search-wrap">
        <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted" style="font-size: 0.9rem;"></i>
        <input type="text" id="categorySearchBox" class="form-control rounded-pill ps-5 bg-light border-0 shadow-none" placeholder="Kategori ara..." style="font-size: 0.95rem;">
    </div>

    <ul class="mt-3 list-unstyled category-scroll" id="categoryList">
        @if (Model != null && Model.Any())
        {
            // Model artık sadece Category değil, Dictionary(Category, int) olduğu için Key ve Value olarak alıyoruz
            foreach (var item in Model)
            {
                var category = item.Key;     // Kategori Nesnesi
                var postCount = item.Value;  // Makale Sayısı

                <li class="border-bottom pb-2 mb-2 category-item">
                    <a href="/Kategori/@category.Slug" class="text-decoration-none text-dark d-flex justify-content-between align-items-center hover-primary">
                        <span class="category-name"><i class="bi bi-chevron-right me-2 text-muted" style="font-size: 12px;"></i> @category.Name</span>

                        <span class="badge bg-light text-secondary rounded-pill border" style="font-weight: 500;">@postCount</span>
                    </a>
                </li>
            }
        }
        else
        {
            <li><span class="text-muted">Kategori bulunamadı.</span></li>
        }
    </ul>
</div>

<script>
    document.getElementById('categorySearchBox').addEventListener('keyup', function () {
        let filterValue = this.value.toLocaleLowerCase('tr-TR');
        let listItems = document.querySelectorAll('#categoryList .category-item');

        listItems.forEach(function (item) {
            let categoryName = item.querySelector('.category-name').textContent.toLocaleLowerCase('tr-TR');
            if (categoryName.indexOf(filterValue) > -1) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    });
</script>