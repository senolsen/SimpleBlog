@model Blog.Web.Models.HeaderNavViewModel
@using Blog.Web.Helpers
@{
    var settings = Model.Settings;
    var siteName = string.IsNullOrWhiteSpace(settings.SiteTitle) ? "SimpleBlog" : settings.SiteTitle;
    var path = Model.CurrentPath.ToLowerInvariant();
    var socialLinks = SocialLinkBuilder.FromSettings(settings);

    bool IsActive(string href)
    {
        if (href == "/") return path == "/" || path == "";
        return path.StartsWith(href.ToLowerInvariant());
    }
}

<header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container-fluid container-xl">
        <div class="header-inner d-flex align-items-center w-100">

            <a href="/" class="logo d-flex align-items-center text-decoration-none">
                @if (!string.IsNullOrEmpty(settings.LogoPath))
                {
                    <img src="@settings.LogoPath" alt="@siteName" class="me-2">
                }
                <h1 class="sitename m-0">@siteName</h1>
            </a>

            <nav id="navmenu" class="navmenu desktop-nav" role="navigation" aria-label="Ana menü">
                <ul>
                    <li><a href="/" class="@(IsActive("/") ? "active" : "")">Ana Sayfa</a></li>
                    <li><a href="/Hakkimizda" class="@(IsActive("/hakkimizda") ? "active" : "")">Hakkımızda</a></li>
                    @if (Model.Categories.Any())
                    {
                        <li class="dropdown">
                            <a href="#" class="@(path.StartsWith("/kategori") ? "active" : "")">
                                <span>Kategoriler</span>
                                <i class="bi bi-chevron-down toggle-dropdown" aria-hidden="true"></i>
                            </a>
                            <ul>
                                @foreach (var category in Model.Categories)
                                {
                                    <li>
                                        <a href="/Kategori/@category.Slug">@category.Name</a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    <li><a href="/Iletisim" class="@(IsActive("/iletisim") ? "active" : "")">İletişim</a></li>
                </ul>
            </nav>

            <div class="header-actions d-flex align-items-center ms-auto">
                <div class="header-social-links d-none d-xl-flex align-items-center">
                    @await Html.PartialAsync("_SocialLinks", socialLinks, new ViewDataDictionary(ViewData) { { "SocialLinksClass", "site-social-links site-social-links--header" } })
                </div>
                <button type="button" id="btnSearchOpen" class="btn-search-open" aria-label="Arama kutusunu aç">
                    <i class="bi bi-search"></i>
                </button>
                <button type="button"
                        class="mobile-drawer-toggle d-xl-none"
                        aria-label="Menüyü aç"
                        aria-expanded="false"
                        aria-controls="mobileDrawer">
                    <i class="bi bi-list"></i>
                </button>
            </div>

        </div>
    </div>
</header>
