@model IEnumerable<Blog.Core.Entities.Post>
@{
    ViewData["Title"] = $"{ViewBag.TagName} Etiketi";
    ViewData["MetaDescription"] = $"{ViewBag.TagName} etiketi ile ilgili en güncel yazılım ve teknoloji makaleleri.";
}

<section id="search-result" class="search-result mt-4">
    <div class="container" data-aos="fade-up">
        <div class="row g-5">

            <div class="col-lg-8">

                <div class="section-header mb-4 border-bottom pb-3">
                    <h3 class="aside-title mb-0">
                        <i class="bi bi-tags text-warning me-2"></i>"@ViewBag.TagName" Etiketi
                    </h3>
                    <p class="text-muted mt-2 mb-0" style="font-size: 0.95rem;">Bu etikette toplam @Model.Count() makale bulundu.</p>
                </div>

                <div class="row g-4 mt-1">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var post in Model)
                        {
                            <div class="d-md-flex post-entry-2 small-img border-bottom pb-4 mb-4 w-100">
                                <a href="/Makale/@post.Slug" class="me-4 thumbnail d-block mb-3 mb-md-0" style="flex: 0 0 300px;">
                                    @if (!string.IsNullOrEmpty(post.CoverImagePath))
                                    {
                                        <img src="@post.CoverImagePath" alt="@post.Title" class="img-fluid rounded shadow-sm" style="width: 100%; height: 200px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <img src="~/themes/zenblog/assets/img/post-landscape-1.jpg" alt="Varsayılan" class="img-fluid rounded shadow-sm" style="width: 100%; height: 200px; object-fit: cover;">
                                    }
                                </a>
                                <div>
                                    <div class="post-meta">
                                        <span class="date text-uppercase" style="color: var(--color-primary); font-weight: 600;">@post.Category?.Name</span>
                                        <span class="mx-1 text-muted">&bullet;</span>
                                        <span class="text-muted">@post.CreatedDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <h3 class="mt-2 mb-3"><a href="/Makale/@post.Slug" class="text-dark fw-bold hover-primary">@post.Title</a></h3>
                                    <p class="text-muted" style="line-height: 1.6;">
                                        @if (!string.IsNullOrEmpty(post.MetaDescription))
                                        {
                                            @post.MetaDescription
                                        }
                                        else
                                        {
                                            var textContent = System.Text.RegularExpressions.Regex.Replace(post.Content, "<.*?>", String.Empty);
                                            @(textContent.Length > 160 ? textContent.Substring(0, 160) + "..." : textContent)
                                        }
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar ps-lg-4">
                    @await Component.InvokeAsync("SidebarCategories")
                    @await Component.InvokeAsync("SidebarPopularPosts")

                    @await Component.InvokeAsync("SidebarTags")
                </div>
            </div>

        </div>
    </div>
</section>