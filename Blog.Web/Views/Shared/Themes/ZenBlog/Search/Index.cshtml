@model IEnumerable<Blog.Core.Entities.Post>
@{
    ViewData["Title"] = $"'{ViewBag.SearchQuery}' Arama Sonuçları";
}

<section id="search-result" class="search-result">
    <div class="container" data-aos="fade-up">
        <div class="row">
            <div class="col-lg-12">
                <h3 class="category-title">Arama Sonucu: "@ViewBag.SearchQuery"</h3>
                <p class="text-muted mb-5">Toplam @Model.Count() sonuç bulundu.</p>

                @if (Model.Any())
                {
                    foreach (var post in Model)
                    {
                        <div class="d-md-flex post-entry-2 small-img border-bottom pb-4 mb-4">
                            <a href="/Makale/@post.Slug" class="me-4 thumbnail">
                                <img src="@post.CoverImagePath" alt="@post.Title" class="img-fluid rounded">
                            </a>
                            <div>
                                <div class="post-meta">
                                    <span class="date">@post.Category.Name</span>
                                    <span class="mx-1">&bullet;</span>
                                    <span>@post.CreatedDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <h3><a href="/Makale/@post.Slug">@post.Title</a></h3>
                                <p>@(post.Content.Length > 200 ? Html.Raw(post.Content.Substring(0, 200) + "...") : Html.Raw(post.Content))</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search display-1 text-muted"></i>
                        <h2 class="mt-3">Üzgünüz, aradığınız kelimeye uygun bir sonuç bulamadık.</h2>
                        <a href="/" class="btn btn-dark mt-3 rounded-pill px-4">Ana Sayfaya Dön</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>