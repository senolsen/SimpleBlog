<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@ViewData["Title"] - Jetexsoft Blog</title>
    <meta content="@ViewData["MetaDescription"]" name="description">

    <!-- Favicons -->
    <link href="~/themes/zenblog/assets/img/favicon.png" rel="icon">
    <link href="~/themes/zenblog/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2 family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

    <!-- Vendor CSS Dosyaları -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

    <!-- ZenBlog Ana CSS Dosyası -->
    <link href="~/themes/zenblog/assets/css/main.css" rel="stylesheet">

    <!-- Arama kutusunun yeni CSS'e tam uyumu için küçük bir garanti stili -->
    <style>
        .custom-search-wrap {
            position: fixed;
            top: -100%;
            left: 0;
            right: 0;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: 0.3s ease-in-out;
            z-index: 9999;
            padding: 20px 0;
        }

            .custom-search-wrap.active {
                top: 0;
            }
    </style>
</head>

<body>

    <!-- ======= Header ======= -->
    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container-fluid container-xl d-flex align-items-center justify-content-between">

            <a href="/" class="logo d-flex align-items-center text-decoration-none">
                <h1 class="sitename m-0">Jetexsoft</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="/">Ana Sayfa</a></li>
                    <li><a href="/Hakkimizda">Hakkımızda</a></li>
                    <li class="dropdown">
                        <a href="#"><span>Kategoriler</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                        <ul>
                            <li><a href="#">Yazılım</a></li>
                            <li><a href="#">Teknoloji</a></li>
                            <li><a href="#">İş Dünyası</a></li>
                        </ul>
                    </li>
                    <li><a href="/Iletisim">İletişim</a></li>
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

            <!-- SAĞ ÜST KISIM: Saf Bootstrap Flex ile Yan Yana Kusursuz Dizilim -->
            <div class="d-flex align-items-center gap-3">
                <a href="#" class="text-dark"><i class="bi bi-twitter-x"></i></a>
                <a href="#" class="text-dark"><i class="bi bi-facebook"></i></a>
                <a href="#" class="text-dark"><i class="bi bi-instagram"></i></a>
                <a href="#" id="btnSearchOpen" class="text-dark ms-2"><i class="bi bi-search fs-5"></i></a>
            </div>

        </div>
    </header>

    <!-- DİNAMİK ARAMA KUTUSU: Temadan bağımsız, kurşun geçirmez yeni yapı -->
    <div id="searchWrap" class="custom-search-wrap">
        <div class="container">
            <form action="/Search" method="get" class="d-flex align-items-center gap-3 w-100">
                <i class="bi bi-search fs-4 text-muted"></i>
                <input type="text" name="q" placeholder="Kelime girin ve Enter'a basın..." class="form-control form-control-lg border-0 shadow-none bg-transparent">
                <button type="button" id="btnSearchClose" class="btn border-0 p-0"><i class="bi bi-x-lg fs-4"></i></button>
            </form>
        </div>
    </div>

    <!-- ======= Main (İçerik Alanı) ======= -->
    <main id="main">
        @RenderBody()
    </main>

    <!-- ======= Footer ======= -->
    <footer id="footer" class="footer mt-5">
        <div class="footer-legal py-4 border-top">
            <div class="container">
                <div class="row align-items-center justify-content-between">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        <div class="copyright">
                            © Copyright <strong><span>Jetexsoft</span></strong>. Tüm Hakları Saklıdır.
                        </div>
                    </div>
                    <!-- ALT KISIM: İkonların d-flex ile yan yana hizalanması garantilendi -->
                    <div class="col-md-6 text-center text-md-end">
                        <div class="d-inline-flex gap-3 fs-5">
                            <a href="#" class="text-secondary"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" class="text-secondary"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-secondary"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="text-secondary"><i class="bi bi-linkedin"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <a href="#" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Vendor JS Dosyaları -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>

    <!-- ZenBlog Ana JS Dosyası -->
    <script src="~/themes/zenblog/assets/js/main.js"></script>

    <!-- Arama Kutusu Tetikleyici Sihirli Script -->
    <script>
        document.getElementById('btnSearchOpen').addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('searchWrap').classList.add('active');
        });

        document.getElementById('btnSearchClose').addEventListener('click', function() {
            document.getElementById('searchWrap').classList.remove('active');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>