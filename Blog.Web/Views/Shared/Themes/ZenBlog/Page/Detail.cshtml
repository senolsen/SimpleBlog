@model Blog.Core.Entities.Page
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = $"{Model.Title} hakkında detaylı bilgiler.";
}

<section class="mb-5">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-between align-items-center bg-light p-5 rounded shadow-sm mt-4">
            <div class="col-12">
                <h2 class="display-5 mb-4" style="font-family: var(--font-secondary); font-weight: 700; color: var(--color-primary);">
                    @Model.Title
                </h2>
                <div class="content-body fs-5 text-muted" style="line-height: 1.8;">
                    @Html.Raw(Model.Content)
                </div>
            </div>
        </div>
    </div>
</section>
