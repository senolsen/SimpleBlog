@model IEnumerable<Blog.Core.Entities.Post>
@{
    ViewData["Title"] = $"{ViewBag.CategoryName} Makaleleri";
    ViewData["MetaDescription"] = $"{ViewBag.CategoryName} kategorisindeki en güncel yazılar.";
}

<section id="posts" class="posts">
    <div class="container" data-aos="fade-up">

        <div class="section-header d-flex justify-content-between align-items-center mb-5">
            <h2 style="font-family: var(--font-secondary); font-weight: 700; color: var(--color-primary);">
                Kategori: @ViewBag.CategoryName
            </h2>
            <span class="badge bg-secondary text-light fs-6 px-3 py-2 rounded-pill">Toplam @Model.Count() Makale</span>
        </div>

        <div class="row g-5">
            <div class="col-lg-8">
                <div class="row g-4">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var post in Model)
                        {
                            <div class="col-md-6">
                                <div class="post-entry-1">
                                    <a href="/Makale/@post.Slug">
                                        @if (!string.IsNullOrEmpty(post.CoverImagePath))
                                        {
                                            <img src="@post.CoverImagePath" alt="@post.Title" class="img-fluid rounded shadow-sm" style="width: 100%; height: 250px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <img src="~/themes/zenblog/assets/img/post-landscape-1.jpg" alt="Varsayılan" class="img-fluid rounded shadow-sm" style="width: 100%; height: 250px; object-fit: cover;">
                                        }
                                    </a>
                                    <div class="post-meta mt-3">
                                        <span class="date text-uppercase" style="color: var(--color-primary); font-weight: 600;">@post.Category.Name</span>
                                        <span class="mx-1 text-muted">&bullet;</span>
                                        <span class="text-muted">@post.CreatedDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <h2 class="mt-2"><a href="/Makale/@post.Slug" class="text-dark hover-primary">@post.Title</a></h2>
                                    <div class="d-flex align-items-center author mt-3">
                                        <div class="photo"><i class="bi bi-person-circle fs-3 text-secondary"></i></div>
                                        <div class="name">
                                            <h3 class="m-0 p-0 fs-6">Jetexsoft Editör</h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5 border rounded bg-light">
                            <i class="bi bi-journal-x display-1 text-muted mb-3 d-block"></i>
                            <h4 class="text-muted">Bu kategoride henüz yayınlanmış bir makale bulunmuyor.</h4>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar ps-lg-4">
                    @await Component.InvokeAsync("SidebarPopularPosts")
                    @await Component.InvokeAsync("SidebarCategories")
                </div>
            </div>
        </div>
    </div>
</section>