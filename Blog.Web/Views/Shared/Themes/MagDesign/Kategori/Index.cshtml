@model IEnumerable<Blog.Core.Entities.Post>
@{
    ViewData["Title"]           = $"{ViewBag.CategoryName} Makaleleri";
    ViewData["MetaDescription"] = $"{ViewBag.CategoryName} kategorisindeki en güncel yazılar.";
}

<div class="mag-page-banner">
    <div class="container">
        <h1><i class="bi bi-folder2-open me-2 text-accent" style="color:var(--accent)"></i>@ViewBag.CategoryName</h1>
        <p>Toplam @Model.Count() makale bulundu.</p>
    </div>
</div>

<div class="container pb-5" data-aos="fade-up">
    <div class="row g-4">

        <div class="col-lg-8">
            @if (Model != null && Model.Any())
            {
                <div class="row g-3">
                    @foreach (var post in Model)
                    {
                        <div class="col-sm-6">
                            <div class="mag-card">
                                <a href="/Makale/@post.Slug" class="mag-card-img">
                                    @if (!string.IsNullOrEmpty(post.CoverImagePath))
                                    {
                                        <img src="@post.CoverImagePath" alt="@post.Title">
                                    }
                                    else
                                    {
                                        <img src="https://placehold.co/600x300/f3f4f6/9ca3af?text=MagDesign" alt="@post.Title">
                                    }
                                </a>
                                <div class="mag-card-body">
                                    <div class="mag-card-meta">
                                        <span class="mag-label">@post.Category?.Name</span>
                                        <span>@post.CreatedDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <div class="mag-card-title">
                                        <a href="/Makale/@post.Slug">@post.Title</a>
                                    </div>
                                    <div class="mag-card-author">
                                        <i class="bi bi-person-circle"></i>
                                        <span>Jetexsoft Editör</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 border rounded bg-light">
                    <i class="bi bi-journal-x display-3 text-muted d-block mb-3"></i>
                    <h4 class="text-muted">Bu kategoride henüz yayınlanmış makale yok.</h4>
                </div>
            }
        </div>

        <div class="col-lg-4">
            @await Component.InvokeAsync("Sidebar")
        </div>

    </div>
</div>
