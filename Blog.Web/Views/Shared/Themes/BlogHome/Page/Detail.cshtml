@model Blog.Core.Entities.Page
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = $"{Model.Title} hakkında detaylı bilgiler.";
}

<header class="bh-page-header py-4 bg-light border-bottom mb-4">
    <div class="container">
        <div class="text-center">
            <h1 class="fw-bolder mb-0"><i class="bi bi-file-text me-2"></i>@Model.Title</h1>
        </div>
    </div>
</header>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body bh-article-body">
                    @Html.Raw(Model.Content)
                </div>
            </div>
        </div>
    </div>
</div>
