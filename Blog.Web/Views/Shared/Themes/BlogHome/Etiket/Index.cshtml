@model IEnumerable<Blog.Core.Entities.Post>

@{

    ViewData["Title"] = $"{ViewBag.TagName} Etiketi";

    ViewData["MetaDescription"] = $"{ViewBag.TagName} etiketiyle ilgili makaleler.";

    var posts = Model?.ToList() ?? new List<Blog.Core.Entities.Post>();

}



<header class="bh-page-header py-4 bg-light border-bottom mb-4">

    <div class="container">

        <div class="text-center">

            <h1 class="fw-bolder mb-2"><i class="bi bi-tag me-2"></i>@ViewBag.TagName</h1>

            <p class="lead mb-0">Bu etikette toplam @posts.Count makale bulundu.</p>

        </div>

    </div>

</header>



<div class="container mb-5">

    <div class="row">

        <div class="col-lg-8">

            @if (posts.Any())

            {

                @foreach (var post in posts)

                {

                    <div class="card mb-4">

                        <div class="row g-0">

                            <div class="col-md-4">

                                <a href="/Makale/@post.Slug">

                                    @if (!string.IsNullOrEmpty(post.CoverImagePath))

                                    {

                                        <img src="@post.CoverImagePath" class="img-fluid rounded-start h-100 object-fit-cover" alt="@post.Title" style="min-height:180px;">

                                    }

                                    else

                                    {

                                        <img src="https://dummyimage.com/400x250/dee2e6/6c757d.jpg" class="img-fluid rounded-start h-100 object-fit-cover" alt="@post.Title" style="min-height:180px;">

                                    }

                                </a>

                            </div>

                            <div class="col-md-8">

                                <div class="card-body">

                                    <div class="small text-muted mb-2">

                                        <span class="badge bg-primary">@post.Category?.Name</span>

                                        <span class="ms-2"><i class="bi bi-calendar3 me-1"></i>@post.CreatedDate.ToString("dd MMMM yyyy")</span>

                                    </div>

                                    <h2 class="card-title h5"><a href="/Makale/@post.Slug" class="text-decoration-none text-dark">@post.Title</a></h2>

                                    <p class="card-text small text-muted">

                                        @if (!string.IsNullOrEmpty(post.MetaDescription))

                                        {

                                            @post.MetaDescription

                                        }

                                        else

                                        {

                                            var txt = System.Text.RegularExpressions.Regex.Replace(post.Content, "<.*?>", "");

                                            @(txt.Length > 160 ? txt.Substring(0, 160) + "…" : txt)

                                        }

                                    </p>

                                    <a class="btn btn-primary btn-sm" href="/Makale/@post.Slug">Devamını oku &rarr;</a>

                                </div>

                            </div>

                        </div>

                    </div>

                }

            }

            else

            {

                <div class="text-center py-5 card">

                    <div class="card-body">

                        <i class="bi bi-journal-x display-3 text-muted d-block mb-3"></i>

                        <h4 class="text-muted">Bu etiket için makale bulunamadı.</h4>

                    </div>

                </div>

            }

        </div>



        <div class="col-lg-4">

            @await Component.InvokeAsync("Sidebar")

        </div>

    </div>

</div>

