@model LoginViewModel
@{
    ViewData["Title"] = "Giriş";
    Layout = "_Layout";
}

<div class="auth-card">
    <div class="auth-header">
        <h1>Giriş Yap</h1>
        <p>Lisans üretim paneline erişmek için giriş yapın.</p>
    </div>

    <form asp-action="Login" method="post" class="form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="MathAnswer">@ViewData["MathQuestion"] = ?</label>
            <input asp-for="MathAnswer" class="form-control" inputmode="numeric" autocomplete="off" />
            <span asp-validation-for="MathAnswer" class="field-error"></span>
            <small class="form-hint">Bot koruması için yukarıdaki işlemin sonucunu girin.</small>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Giriş Yap</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
