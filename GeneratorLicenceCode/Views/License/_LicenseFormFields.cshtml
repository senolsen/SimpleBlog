@model LicenseFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

<div class="form-group">
    <label asp-for="Domain"></label>
    <input asp-for="Domain" class="form-control" placeholder="ornek: musteri.com" />
    <span asp-validation-for="Domain" class="field-error"></span>
    <small class="form-hint">www olmadan, küçük harfle yazılması önerilir.</small>
</div>

<div class="form-group">
    <label asp-for="CustomerName"></label>
    <input asp-for="CustomerName" class="form-control" placeholder="Müşteri veya firma adı" />
    <span asp-validation-for="CustomerName" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="Notes"></label>
    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="İsteğe bağlı notlar"></textarea>
    <span asp-validation-for="Notes" class="field-error"></span>
</div>

<div class="form-group form-check">
    <label class="checkbox-label">
        <input asp-for="IsActive" type="checkbox" />
        <span>Aktif lisans</span>
    </label>
</div>

@if (ViewData["showKey"] as bool? == true && !string.IsNullOrEmpty(Model.LicenseKey))
{
    <div class="form-group">
        <label asp-for="LicenseKey"></label>
        <div class="license-key-box">
            <code>@Model.LicenseKey</code>
        </div>
        <small class="form-hint">Domain değiştirildiğinde anahtar otomatik yenilenir.</small>
    </div>
}

@if (ViewData["showMeta"] as bool? == true)
{
    <div class="meta-grid">
        <div>
            <strong>Oluşturma</strong>
            <p>@Model.CreatedDate?.ToString("dd.MM.yyyy HH:mm") @(Model.CreatedBy != null ? $"— {Model.CreatedBy}" : "")</p>
        </div>
        <div>
            <strong>Son Güncelleme</strong>
            <p>
                @if (Model.UpdatedDate.HasValue)
                {
                    @Model.UpdatedDate.Value.ToString("dd.MM.yyyy HH:mm") @(Model.UpdatedBy != null ? $"— {Model.UpdatedBy}" : "")
                }
                else
                {
                    <span class="muted">—</span>
                }
            </p>
        </div>
    </div>
}
